/* pages/settings/settings.wxss
   与看板/储存页统一：白色分组卡 + 横排表单行 + 药丸按钮 */

.st-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
}
.st-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.st-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.st-title-row .st-title {
  margin-bottom: 0;
}

/* 横排表单行：标签左、控件右 */
.st-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}
.st-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.st-input {
  flex: 1;
  min-width: 0;
  max-width: 320rpx;
  background: rgba(15, 23, 42, 0.04);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  text-align: right;
  color: var(--text-primary);
}
.st-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 14rpx;
  line-height: 1.6;
}
.st-ghost-btn {
  margin-top: 20rpx;
  background: rgba(15, 23, 42, 0.05);
  color: var(--text-secondary);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 0;
}
.st-ghost-btn::after { border: none; }
.st-mini-btn {
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  line-height: 1.4;
}
.st-mini-btn::after { border: none; }

/* 配色实时预览 */
.preview-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}
.preview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 颜色行 */
.color-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(15, 23, 42, 0.04);
}
.color-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  flex: 1;
}
.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.1);
  flex-shrink: 0;
}
.color-input {
  width: 200rpx;
  font-size: 24rpx;
  text-align: center;
  background: rgba(15, 23, 42, 0.04);
  border-radius: 12rpx;
  padding: 10rpx 0;
  font-variant-numeric: tabular-nums;
}

/* 区域行 */
.area-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: center;
}
.area-row .area-input {
  flex: 1;
}
.area-row .tables-input {
  flex: 1.5;
}
/* 区域删除按钮复用储存页药丸样式 */
.ra-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}
.ra-btn::after { border: none; }
.ra-danger {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
}

/* 数据管理 2×2 按钮 */
.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.data-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: rgba(15, 23, 42, 0.04);
  border-radius: 20rpx;
  padding: 26rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin: 0;
}
.data-btn::after { border: none; }
.data-btn:active { transform: scale(0.97); }
.data-warn {
  background: rgba(245, 158, 11, 0.1);
  color: #b45309;
}
.data-danger {
  background: rgba(239, 68, 68, 0.08);
  color: #ef4444;
}
