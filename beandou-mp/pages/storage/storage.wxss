/* pages/storage/storage.wxss
   与看板页统一：白卡 + 实色药丸 + 柔和阴影；逾期卡红光呼吸 */

/* 统计条 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 12rpx;
  margin-bottom: 20rpx;
}
.mini-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ms-num {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.ms-alarm {
  animation: ms-blink 1.2s ease-in-out infinite;
}
@keyframes ms-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
.ms-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.ms-divider {
  width: 2rpx;
  height: 52rpx;
  background: rgba(15, 23, 42, 0.08);
}

/* 搜索 + 分段筛选 */
.toolbar {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(15, 23, 42, 0.04);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.search-icon {
  font-size: 26rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}
.search-clear {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
}
.seg {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  background: rgba(15, 23, 42, 0.04);
  border-radius: 999rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 10rpx 0;
  border-radius: 999rpx;
  transition: all 0.2s;
}
.seg-active {
  background: #ffffff;
  color: var(--text-primary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.1);
}

/* 记录卡 */
.storage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rec-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
  overflow: hidden;
}
/* 逾期：红色光晕呼吸，与超时桌同一语言 */
.rec-overdue {
  animation: rec-glow 2s ease-in-out infinite;
}
@keyframes rec-glow {
  0%, 100% { box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.1), 0 12rpx 28rpx rgba(239, 68, 68, 0.26); }
  50% { box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.18), 0 16rpx 38rpx rgba(239, 68, 68, 0.42); }
}
/* 已取走：整卡降调 */
.rec-picked {
  opacity: 0.68;
}

.rec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.rec-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rec-who {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.rec-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rec-phone {
  font-size: 22rpx;
  color: var(--text-muted);
}
/* 状态药丸 */
.rec-pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.p-stored {
  background: #3b82f6;
  color: #fff;
}
.p-overdue {
  background: #ef4444;
  color: #fff;
}
.p-picked {
  background: rgba(100, 116, 139, 0.12);
  color: #64748b;
}

/* 作品行：本卡的"主角"信息 */
.rec-work {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 18rpx 0 6rpx;
}
.rec-work-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-muted);
  background: rgba(15, 23, 42, 0.05);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.rec-work-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rec-dates {
  font-size: 22rpx;
  color: var(--text-muted);
}
.rec-notes {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: rgba(15, 23, 42, 0.03);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮 */
.rec-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(15, 23, 42, 0.05);
}
.ra-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}
.ra-btn::after { border: none; }
.ra-primary {
  background: #22c55e;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.3);
}
.ra-ghost {
  background: rgba(15, 23, 42, 0.05);
  color: var(--text-secondary);
}
.ra-danger {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0 60rpx;
  color: var(--text-muted);
  font-size: 30rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #60a5fa, #3b82f6);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  z-index: 998;
  line-height: 1;
  padding-bottom: 6rpx;
  box-sizing: border-box;
}
.fab:active {
  transform: scale(0.94);
}
