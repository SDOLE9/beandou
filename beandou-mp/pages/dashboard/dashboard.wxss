/* pages/dashboard/dashboard.wxss */
/* 自定义导航栏样式在 app.wxss 中全局定义 */

/* 统计卡片栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 16rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.filter-btn {
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.legend-bar {
  display: flex;
  gap: 14rpx;
  margin-left: auto;
  flex-wrap: wrap;
  align-items: center;
}
.legend-item {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}
.dot.warn { background: var(--c-warn, #f59e0b); }

/* 区域标题：统计已汇总在顶部统计卡，这里只留区域名 */
.area-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
}
.area-name {
  font-size: 30rpx;
  font-weight: 700;
}
.area-total {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 统计栏超时数字：有超时桌时闪一下提醒 */
.overtime-alarm {
  animation: alarm-blink 1.2s ease-in-out infinite;
}
@keyframes alarm-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* 桌台看板 */
.area-section {
  margin-bottom: 32rpx;
}
.table-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 弹窗表单行 */
.form-row {
  margin-bottom: 24rpx;
}

/* 加购行 */
.item-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: center;
}
.item-row .item-name {
  flex: 2;
}
.item-row .item-price {
  flex: 1;
}
.item-row .item-qty {
  flex: 1;
  min-width: 100rpx;
}

/* Toast */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 24rpx 40rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  z-index: 2000;
  max-width: 80%;
  text-align: center;
}
.toast.success {
  background: rgba(34, 197, 94, 0.9);
}
.toast.error {
  background: rgba(239, 68, 68, 0.9);
}
